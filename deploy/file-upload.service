[Unit]
Description=files.lbgos.dev upload service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/file-upload
EnvironmentFile=/root/file-upload/.env
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=DATA_DIR=/root/file-upload/data
ExecStart=/usr/bin/node /root/file-upload/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/file-upload/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
